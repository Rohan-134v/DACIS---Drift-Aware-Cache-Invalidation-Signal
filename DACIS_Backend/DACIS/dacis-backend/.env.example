# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Model ────────────────────────────────────────────────────────────────
MODEL_INPUT_DIM=16
MODEL_HIDDEN_DIM=64
MODEL_PATH=models/dacis_graphsage.pt

# ── Gate 1 — Account-level Welford tripwire ──────────────────────────────
Z_THRESH=3.0
BURN_IN_MIN_COUNT=5

# ── Gate 2 — Community-level Welford confirmation ────────────────────────
GATE2_Z_THRESH=3.0
GATE2_BURN_IN_MIN_COUNT=5

# Gate 2 showed no validated independent discriminative signal in research
# evaluation across 4 datasets — see README.  Enable only for
# exploratory/demo purposes, never as a default.
# GATE2_SCORE_BOOST_ENABLED=false

# ── Score fusion ─────────────────────────────────────────────────────────
GATE1_BOOST_MULTIPLIER=1.5
GATE2_BOOST_MULTIPLIER=1.2

# ── Graph ────────────────────────────────────────────────────────────────
L_HOPS=1
MAX_NEIGHBORS_PER_HOP=25

# ── Embedding cache ─────────────────────────────────────────────────────
EMBEDDING_CACHE_L1_MAX_SIZE=10000
EMBEDDING_CACHE_L2_TTL=3600

# ── Union-find ───────────────────────────────────────────────────────────
UNION_FIND_FLUSH_INTERVAL=100

# ── Burst injection (demo) ──────────────────────────────────────────────
DEFAULT_RING_SIZE=6
DEFAULT_BURST_LENGTH=40

# ── Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
